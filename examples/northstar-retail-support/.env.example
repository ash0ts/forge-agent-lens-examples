# W&B is required for the default model route and Agent Lens export.
WANDB_API_KEY=
# Optional direct model provider.
ANTHROPIC_API_KEY=
# Optional Jev decision layer; used only with a live shadow or route mode.
TYPESAFE_API_KEY=

# Projects use the entity/project form.
WANDB_INFERENCE_PROJECT=wandb/agent-lens-retail-chat-demo-v1
AGENT_LENS_PROJECT=wandb/agent-lens-retail-support-live-v10
AGENT_LENS_ENABLED=true

# Optional application settings.
RETAIL_DEMO_SESSION_COST_CAP_USD=50
RETAIL_DEMO_IDLE_TTL_SECONDS=1800
RETAIL_DEMO_HOST=127.0.0.1
RETAIL_DEMO_PORT=4180
# The default uses Forge Serverless Inference. Any configured route can also be
# selected in the browser.
RETAIL_DEMO_DEFAULT_MODEL_ROUTE=wandb-glm-5-3-flash

# Optional TypeSafe Jev decision layer. Start in shadow so Jev's route is
# recorded beside the existing deterministic route without changing behavior.
# Supported modes: off, shadow, route.
RETAIL_DEMO_JEV_MODE=off
# `live` calls TypeSafe and requires TYPESAFE_API_KEY. `mock` is explicitly
# labeled local integration scaffolding; it does not measure Jev quality.
RETAIL_DEMO_JEV_BACKEND=live
RETAIL_DEMO_JEV_MODEL=jev-1.13.0
RETAIL_DEMO_JEV_ROUTE_CONFIDENCE_THRESHOLD=0.75
RETAIL_DEMO_JEV_TIMEOUT_SECONDS=2.0
